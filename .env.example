# Copy this file to .env and fill in your own credentials.

# Supabase — Find these in your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe (server-side only — set this in Vercel's Environment Variables, never commit a real key)
STRIPE_SECRET_KEY=sk_test_...

# ── E-mails de devis / revendication (server-side only, Vercel Environment Variables) ──
# Resend (https://resend.com) : créez un compte, vérifiez un domaine d'envoi,
# puis générez une clé API dans Dashboard > API Keys.
RESEND_API_KEY=re_...
# Expéditeur — doit être sur le domaine que vous avez vérifié dans Resend.
QUOTES_FROM_EMAIL="ROBOT MARKET <devis@obovia.com>"
# Adresse qui reçoit toutes les demandes de devis et de revendication.
ADMIN_EMAIL=admin@obovia.com

# Supabase — clé service_role (JAMAIS le préfixe VITE_, jamais exposée au navigateur).
# Settings > API > service_role secret. Permet aux fonctions /api d'écrire dans
# quote_requests / claim_requests même avec les policies RLS activées.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
